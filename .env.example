# Public browser credentials (safe to expose to client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Feature flag for live notes (CTA + pinned card + cron)
LIVE_NOTES_ENABLED=true
LIVE_NOTE_DURATION_HOURS=4

# Server-only: Supabase service_role (never NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only: Google Service Account for Drive (never NEXT_PUBLIC_*)
# Base64-encoded JSON of the SA key file (cat sa.json | base64 -w0)
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_JSON=eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9...
GOOGLE_DRIVE_ROOT_ID=your-drive-root-folder-id

# Server-only: cron guard for POST /api/cron/archive-live-notes
CRON_SECRET=your-random-cron-secret
